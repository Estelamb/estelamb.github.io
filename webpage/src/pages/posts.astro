---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';

// Esto busca todos los archivos .md en esta misma carpeta
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
---

<Layout title="Posts y Artículos">
  <nav class="flex flex-col md:flex-row justify-between items-center p-6 gap-6 max-w-6xl mx-auto w-full">
    <div class="flex flex-wrap justify-center gap-4 text-sm font-medium text-gray-700 dark:text-gray-300">
      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Inicio</a>
      <a href="/estudios" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Estudios</a>
      <a href="/posts" class="text-blue-600 dark:text-blue-400 font-bold transition-colors">Posts</a>
    </div>
    <button id="theme-toggle" class="p-2 rounded-full border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
      <svg id="moon-icon" class="w-5 h-5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
      <svg id="sun-icon" class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 2.32a1 1 0 011.415 0l.708.708a1 1 0 01-1.414 1.415l-.708-.708a1 1 0 010-1.415zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zm-2.32 4.22a1 1 0 010 1.415l-.708.708a1 1 0 01-1.414-1.415l.708-.708a1 1 0 011.415 0zM10 18a1 1 0 01-1-1v-1a1 1 0 112 0v1a1 1 0 01-1 1zm-4.22-2.32a1 1 0 01-1.415 0l-.708-.708a1 1 0 011.414-1.415l.708.708a1 1 0 010 1.415zM2 10a1 1 0 011-1h1a1 1 0 110 2H3a1 1 0 01-1-1zm2.32-4.22a1 1 0 010-1.415l.708-.708a1 1 0 011.414 1.415l-.708.708a1 1 0 01-1.415 0zM10 5a5 5 0 100 10 5 5 0 000-10z" clip-rule="evenodd"></path></svg>
    </button>
  </nav>

  <main class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-10">Artículos y Publicaciones</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {allPosts.map((post) => (
        <a href={post.url} class="block p-6 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm hover:scale-[1.02] hover:border-blue-500 transition-all">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">{post.frontmatter.title}</h2>
          <p class="text-gray-600 dark:text-gray-400 text-sm mb-4">{post.frontmatter.description}</p>
          <span class="text-xs font-mono text-blue-600 dark:text-blue-400">{post.frontmatter.date}</span>
        </a>
      ))}
    </div>
  </main>
</Layout>

<script is:inline>
  const themeBtn = document.getElementById('theme-toggle');
  const htmlDoc = document.documentElement;
  if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) { htmlDoc.classList.add('dark'); }
  themeBtn.addEventListener('click', () => {
    htmlDoc.classList.toggle('dark');
    localStorage.setItem('theme', htmlDoc.classList.contains('dark') ? 'dark' : 'light');
  });
</script>