---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import pubData from '../data/publications.json';

// FILTROS INTELIGENTES: Solo pasamos a la web los que NO tengan "public: false"
const visiblePapers = pubData.papers?.filter(item => item.public !== false) || [];
const visibleSoftware = pubData.software?.filter(item => item.public !== false) || [];
const visibleOther = pubData.other?.filter(item => item.public !== false) || [];
---

<Layout title="Publications - Estela Mora Barba">
  <nav class="flex flex-col md:flex-row justify-between items-center p-6 gap-6 max-w-6xl mx-auto w-full">
    <a href="/" class="text-gray-900 dark:text-white font-medium flex items-center group hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
      <svg class="w-5 h-5 mr-2 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      <span class="lang-en block">Back to home</span>
      <span class="lang-es hidden">Volver al inicio</span>
    </a>

    <div class="flex flex-wrap justify-center gap-4 text-sm font-medium text-gray-700 dark:text-gray-300">
      <a href="/education" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Education</span><span class="lang-es hidden">Formación</span>
      </a>
      <a href="/experience" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Experience</span><span class="lang-es hidden">Experiencia</span>
      </a>
      <a href="/projects" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Projects</span><span class="lang-es hidden">Proyectos</span>
      </a>
      <a href="/teaching" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Teaching</span><span class="lang-es hidden">Docencia</span>
      </a>
      <a href="/publications" class="text-blue-600 dark:text-blue-400 font-bold transition-colors">
        <span class="lang-en block">Publications</span><span class="lang-es hidden">Publicaciones</span>
      </a>
      <a href="/awards" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Awards</span><span class="lang-es hidden">Premios</span>
      </a>
      <a href="/posts" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Posts</span><span class="lang-es hidden">Posts</span>
      </a>
    </div>

    <div class="flex items-center gap-4">
      <button id="lang-toggle" class="px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
        EN / ES
      </button>
      <button id="theme-toggle" class="p-2 rounded-full border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Toggle Dark Mode">
        <svg id="moon-icon" class="w-5 h-5 block dark:hidden text-gray-700" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
        <svg id="sun-icon" class="w-5 h-5 hidden dark:block text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 2.32a1 1 0 011.415 0l.708.708a1 1 0 01-1.414 1.415l-.708-.708a1 1 0 010-1.415zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zm-2.32 4.22a1 1 0 010 1.415l-.708.708a1 1 0 01-1.414-1.415l.708-.708a1 1 0 011.415 0zM10 18a1 1 0 01-1-1v-1a1 1 0 112 0v1a1 1 0 01-1 1zm-4.22-2.32a1 1 0 01-1.415 0l-.708-.708a1 1 0 011.414-1.415l.708.708a1 1 0 010 1.415zM2 10a1 1 0 011-1h1a1 1 0 110 2H3a1 1 0 01-1-1zm2.32-4.22a1 1 0 010-1.415l.708-.708a1 1 0 011.414 1.415l-.708.708a1 1 0 01-1.415 0zM10 5a5 5 0 100 10 5 5 0 000-10z" clip-rule="evenodd"></path></svg>
      </button>
    </div>
  </nav>

  <main class="max-w-4xl mx-auto px-6 py-12">
    <header class="mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-emerald-500 mb-4">
        <span class="lang-en block">{pubData.header.title.en}</span>
        <span class="lang-es hidden">{pubData.header.title.es}</span>
      </h1>
      <p class="text-gray-600 dark:text-gray-400 text-lg">
        <span class="lang-en block">{pubData.header.subtitle.en}</span>
        <span class="lang-es hidden">{pubData.header.subtitle.es}</span>
      </p>
    </header>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
        <svg class="w-6 h-6 mr-3 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
        <span class="lang-en block">{pubData.categories.papers.en}</span>
        <span class="lang-es hidden">{pubData.categories.papers.es}</span>
      </h2>
      <div class="grid gap-6">
        {visiblePapers.length > 0 ? visiblePapers.map((pub) => (
          <div class="p-6 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm hover:border-blue-500 transition-colors flex flex-col h-full">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
              <span class="lang-en block">{pub.title.en}</span>
              <span class="lang-es hidden">{pub.title.es}</span>
            </h3>
            <p class="text-gray-800 dark:text-gray-200 font-medium mb-1">{pub.authors}</p>
            <div class="flex flex-wrap gap-2 items-center text-sm mb-4">
              <span class="text-blue-600 dark:text-blue-400 font-medium italic">{pub.journal}</span>
              <span class="text-gray-400">•</span>
              <span class="text-gray-500 font-mono">{pub.date}</span>
            </div>
            <p class="text-gray-600 dark:text-gray-400 mb-4 leading-relaxed flex-grow">
              <span class="lang-en block">{pub.description.en}</span>
              <span class="lang-es hidden">{pub.description.es}</span>
            </p>
            {pub.link && pub.link !== "#" && (
              <div class="mt-auto pt-4 border-t border-gray-100 dark:border-gray-800">
                <a href={pub.link} target="_blank" class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">
                  <span class="lang-en block">View Publication</span>
                  <span class="lang-es hidden">Ver Publicación</span>
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              </div>
            )}
          </div>
        )) : <p class="text-gray-500 dark:text-gray-400 italic bg-gray-50 dark:bg-gray-800/50 p-4 rounded-xl border border-dashed border-gray-200 dark:border-gray-700">
              <span class="lang-en block">{pubData.emptyState.en}</span>
              <span class="lang-es hidden">{pubData.emptyState.es}</span>
             </p>}
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
        <svg class="w-6 h-6 mr-3 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
        <span class="lang-en block">{pubData.categories.software.en}</span>
        <span class="lang-es hidden">{pubData.categories.software.es}</span>
      </h2>
      <div class="grid gap-6">
        {visibleSoftware.length > 0 ? visibleSoftware.map((sw) => (
          <div class="p-6 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm hover:border-emerald-500 transition-colors">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
              <span class="lang-en block">{sw.title.en}</span>
              <span class="lang-es hidden">{sw.title.es}</span>
            </h3>
            <p class="text-gray-800 dark:text-gray-200 font-medium mb-2">{sw.authors}</p>
            <div class="flex flex-wrap gap-2 items-center text-sm mb-4">
              <span class="px-2.5 py-1 rounded-md text-xs font-mono font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">{sw.registry}</span>
              <span class="text-gray-500 font-mono ml-2">{sw.date}</span>
            </div>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
              <span class="lang-en block">{sw.description.en}</span>
              <span class="lang-es hidden">{sw.description.es}</span>
            </p>
          </div>
        )) : <p class="text-gray-500 dark:text-gray-400 italic bg-gray-50 dark:bg-gray-800/50 p-4 rounded-xl border border-dashed border-gray-200 dark:border-gray-700">
              <span class="lang-en block">{pubData.emptyState.en}</span>
              <span class="lang-es hidden">{pubData.emptyState.es}</span>
             </p>}
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
        <svg class="w-6 h-6 mr-3 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
        <span class="lang-en block">{pubData.categories.other.en}</span>
        <span class="lang-es hidden">{pubData.categories.other.es}</span>
      </h2>
      <div class="grid gap-6">
        {visibleOther.length > 0 ? visibleOther.map((item) => (
          <div class="p-6 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm hover:border-purple-500 transition-colors flex flex-col h-full">
            
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
              <span class="lang-en block">{item.title.en}</span>
              <span class="lang-es hidden">{item.title.es}</span>
            </h3>

            <div class="flex flex-wrap gap-2 items-center text-sm mb-1">
              <span class="text-purple-600 dark:text-purple-400 font-bold">
                <span class="lang-en block">{item.type.en}</span>
                <span class="lang-es hidden">{item.type.es}</span>
              </span>
              <span class="text-gray-400">•</span>
              <span class="text-gray-600 dark:text-gray-300 font-medium">{item.institution}</span>
              <span class="text-gray-400">•</span>
              <span class="text-gray-500 font-mono">{item.date}</span>
            </div>

            {item.study && (
              <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">
                <span class="lang-en block">{item.study.en}</span>
                <span class="lang-es hidden">{item.study.es}</span>
              </p>
            )}

            {(item.tutor || item.director) && (
              <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-500 dark:text-gray-400 mb-3">
                {item.tutor && (
                  <p class="flex items-center">
                    <svg class="w-4 h-4 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    <span class="lang-en block">Tutor: {item.tutor}</span>
                    <span class="lang-es hidden">Tutor: {item.tutor}</span>
                  </p>
                )}
                {item.director && (
                  <p class="flex items-center">
                    <svg class="w-4 h-4 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    <span class="lang-en block">Director: {item.director}</span>
                    <span class="lang-es hidden">Director: {item.director}</span>
                  </p>
                )}
              </div>
            )}

            <p class="text-gray-600 dark:text-gray-400 mb-4 leading-relaxed flex-grow">
              <span class="lang-en block">{item.description.en}</span>
              <span class="lang-es hidden">{item.description.es}</span>
            </p>
            
            <div class="mt-auto pt-4 border-t border-gray-100 dark:border-gray-800 flex flex-wrap items-center justify-between gap-4">
              {item.link && item.link !== "#" ? (
                <a href={item.link} target="_blank" class="inline-flex items-center text-sm font-medium text-purple-600 dark:text-purple-400 hover:underline">
                  <span class="lang-en block">View Document</span>
                  <span class="lang-es hidden">Ver Documento</span>
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              ) : <div></div>}

              {item.prize && (
                <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-800 border border-yellow-200 dark:bg-yellow-900/30 dark:text-yellow-400 dark:border-yellow-800">
                  <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.617a1 1 0 01.894-1.788l1.599.799L9 4.323V3a1 1 0 011-1z" clip-rule="evenodd"></path></svg>
                  <span class="lang-en block">{item.prize.en}</span>
                  <span class="lang-es hidden">{item.prize.es}</span>
                </div>
              )}
            </div>

          </div>
        )) : <p class="text-gray-500 dark:text-gray-400 italic bg-gray-50 dark:bg-gray-800/50 p-4 rounded-xl border border-dashed border-gray-200 dark:border-gray-700">
              <span class="lang-en block">{pubData.emptyState.en}</span>
              <span class="lang-es hidden">{pubData.emptyState.es}</span>
             </p>}
      </div>
    </section>

  </main>
</Layout>

<script is:inline>
  const themeBtn = document.getElementById('theme-toggle');
  const htmlDoc = document.documentElement;
  
  if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    htmlDoc.classList.add('dark');
  }

  themeBtn.addEventListener('click', () => {
    htmlDoc.classList.toggle('dark');
    localStorage.setItem('theme', htmlDoc.classList.contains('dark') ? 'dark' : 'light');
  });

  const langBtn = document.getElementById('lang-toggle');
  const enElements = document.querySelectorAll('.lang-en');
  const esElements = document.querySelectorAll('.lang-es');
  
  let currentLang = localStorage.getItem('lang') || 'en';

  function renderLanguage() {
    if (currentLang === 'en') {
      enElements.forEach(el => { el.classList.remove('hidden'); el.classList.add('block'); });
      esElements.forEach(el => { el.classList.add('hidden'); el.classList.remove('block'); });
    } else {
      esElements.forEach(el => { el.classList.remove('hidden'); el.classList.add('block'); });
      enElements.forEach(el => { el.classList.add('hidden'); el.classList.remove('block'); });
    }
  }

  renderLanguage();

  langBtn.addEventListener('click', () => {
    currentLang = currentLang === 'en' ? 'es' : 'en';
    localStorage.setItem('lang', currentLang);
    renderLanguage();
  });
</script>