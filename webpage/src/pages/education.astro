---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import educationData from '../data/education.json';
---

<Layout title="Education - Estela Mora Barba">
  <nav class="flex flex-col md:flex-row justify-between items-center p-6 gap-6 max-w-6xl mx-auto w-full">
    <a href="/" class="text-gray-900 dark:text-white font-medium flex items-center group hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
      <svg class="w-5 h-5 mr-2 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      <span class="lang-en block">Back to home</span>
      <span class="lang-es hidden">Volver al inicio</span>
    </a>

    <div class="flex flex-wrap justify-center gap-4 text-sm font-medium text-gray-700 dark:text-gray-300">
      <a href="/education" class="text-blue-600 dark:text-blue-400 font-bold transition-colors">
        <span class="lang-en block">Education</span><span class="lang-es hidden">Formación</span>
      </a>
      <a href="/experience" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Experience</span><span class="lang-es hidden">Experiencia</span>
      </a>
      <a href="/projects" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Projects</span><span class="lang-es hidden">Proyectos</span>
      </a>
      <a href="/teaching" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Teaching</span><span class="lang-es hidden">Docencia</span>
      </a>
      <a href="/publications" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Publications</span><span class="lang-es hidden">Publicaciones</span>
      </a>
      <a href="/awards" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Awards</span><span class="lang-es hidden">Premios</span>
      </a>
      <a href="/posts" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Posts</span><span class="lang-es hidden">Posts</span>
      </a>
    </div>

    <div class="flex items-center gap-4">
      <button id="lang-toggle" class="px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
        EN / ES
      </button>
      <button id="theme-toggle" class="p-2 rounded-full border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Toggle Dark Mode">
        <svg id="moon-icon" class="w-5 h-5 block dark:hidden text-gray-700" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
        <svg id="sun-icon" class="w-5 h-5 hidden dark:block text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 2.32a1 1 0 011.415 0l.708.708a1 1 0 01-1.414 1.415l-.708-.708a1 1 0 010-1.415zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zm-2.32 4.22a1 1 0 010 1.415l-.708.708a1 1 0 01-1.414-1.415l.708-.708a1 1 0 011.415 0zM10 18a1 1 0 01-1-1v-1a1 1 0 112 0v1a1 1 0 01-1 1zm-4.22-2.32a1 1 0 01-1.415 0l-.708-.708a1 1 0 011.414-1.415l.708.708a1 1 0 010 1.415zM2 10a1 1 0 011-1h1a1 1 0 110 2H3a1 1 0 01-1-1zm2.32-4.22a1 1 0 010-1.415l.708-.708a1 1 0 011.414 1.415l-.708.708a1 1 0 01-1.415 0zM10 5a5 5 0 100 10 5 5 0 000-10z" clip-rule="evenodd"></path></svg>
      </button>
    </div>
  </nav>

  <main class="max-w-4xl mx-auto px-6 py-12">
    <header class="mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-emerald-500 mb-4">
        <span class="lang-en block">{educationData.header?.title?.en}</span>
        <span class="lang-es hidden">{educationData.header?.title?.es}</span>
      </h1>
      <p class="text-gray-600 dark:text-gray-400 text-lg">
        <span class="lang-en block">{educationData.header?.subtitle?.en}</span>
        <span class="lang-es hidden">{educationData.header?.subtitle?.es}</span>
      </p>
    </header>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 flex items-center">
        <svg class="w-6 h-6 mr-3 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path></svg>
        <span class="lang-en block">{educationData.categories?.academic?.en}</span>
        <span class="lang-es hidden">{educationData.categories?.academic?.es}</span>
      </h2>
      <div class="relative border-l-2 border-gray-200 dark:border-gray-800 ml-3">
        {educationData.academic && educationData.academic.map((item) => (
          <div class="mb-12 ml-8 relative last:mb-0">
            <span class={`absolute w-4 h-4 rounded-full -left-[41px] top-1 ring-4 ring-slate-50 dark:ring-gray-950 ${item.current ? 'bg-blue-500' : 'bg-gray-300 dark:bg-gray-700'}`}>
              {item.current && <span class="absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75 animate-ping"></span>}
            </span>
            <div class="flex flex-wrap gap-3 items-center mb-2">
              <time class="text-sm font-mono text-gray-500 dark:text-gray-400">
                <span class="lang-en block">{item.date?.en}</span>
                <span class="lang-es hidden">{item.date?.es}</span>
              </time>
              {item.current && 
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                  <span class="lang-en block">{educationData.badges?.ongoing?.en}</span>
                  <span class="lang-es hidden">{educationData.badges?.ongoing?.es}</span>
                </span>
              }
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mt-1 mb-1">
              <span class="lang-en block">{item.title?.en}</span>
              <span class="lang-es hidden">{item.title?.es}</span>
            </h3>
            
            <p class="text-blue-600 dark:text-blue-400 font-medium mb-3">{item.institution}</p>

            {item.prize && (
              <div class="mb-3 flex items-center gap-1.5 px-3 py-1 w-fit rounded-md bg-yellow-50 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400 border border-yellow-200 dark:border-yellow-800/50">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.617a1 1 0 01.894-1.788l1.599.799L9 4.323V3a1 1 0 011-1z" clip-rule="evenodd"></path></svg>
                <span class="text-[11px] font-bold uppercase tracking-wider">
                  <span class="lang-en block">{item.prize?.en}</span>
                  <span class="lang-es hidden">{item.prize?.es}</span>
                </span>
              </div>
            )}

            {item.link && (
              <div class="mt-2">
                <a href={item.link} target="_blank" class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">
                  <span class="lang-en block">View Curriculum</span>
                  <span class="lang-es hidden">Ver Plan de Estudios</span>
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 flex items-center">
        <svg class="w-6 h-6 mr-3 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path></svg>
        <span class="lang-en block">{educationData.categories?.music?.en}</span>
        <span class="lang-es hidden">{educationData.categories?.music?.es}</span>
      </h2>
      <div class="relative border-l-2 border-pink-200 dark:border-pink-900/50 ml-3">
        {educationData.music && educationData.music.map((item) => (
          <div class="mb-10 ml-8 relative last:mb-0">
            <span class={`absolute w-4 h-4 rounded-full -left-[41px] top-1 ring-4 ring-slate-50 dark:ring-gray-950 ${item.current || item.highlight ? 'bg-pink-500' : 'bg-gray-300 dark:bg-gray-700'}`}>
              {(item.current || item.highlight) && <span class="absolute inline-flex h-full w-full rounded-full bg-pink-400 opacity-75 animate-ping"></span>}
            </span>
            <time class="text-sm font-mono text-gray-500 dark:text-gray-400">
              <span class="lang-en block">{item.date?.en}</span>
              <span class="lang-es hidden">{item.date?.es}</span>
            </time>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mt-1 mb-1">
              <span class="lang-en block">{item.title?.en}</span>
              <span class="lang-es hidden">{item.title?.es}</span>
            </h3>
            <p class="text-pink-600 dark:text-pink-400 font-medium">{item.institution}</p>

            {item.link && (
              <div class="mt-2">
                <a href={item.link} target="_blank" class="inline-flex items-center text-sm font-medium text-pink-600 dark:text-pink-400 hover:underline">
                  <span class="lang-en block">View Official Details</span>
                  <span class="lang-es hidden">Ver Detalles Oficiales</span>
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <section>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center border-b border-gray-200 dark:border-gray-800 pb-3">
          <svg class="w-5 h-5 mr-3 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
          <span class="lang-en block">{educationData.categories?.certifications?.en}</span>
          <span class="lang-es hidden">{educationData.categories?.certifications?.es}</span>
        </h2>
        <div class="space-y-4">
          {educationData.certifications && educationData.certifications.map((cert) => (
            <div class="p-5 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-orange-100 dark:border-orange-900/30 rounded-xl shadow-sm">
              <h3 class="font-bold text-gray-900 dark:text-white mb-1">
                <span class="lang-en block">{cert.title?.en}</span>
                <span class="lang-es hidden">{cert.title?.es}</span>
              </h3>
              <p class="text-sm font-medium text-orange-600 dark:text-orange-400 mb-1">{cert.institution}</p>
              <p class="text-xs font-mono text-gray-500">
                <span class="lang-en block">{cert.date?.en}</span>
                <span class="lang-es hidden">{cert.date?.es}</span>
              </p>
            </div>
          ))}
        </div>
      </section>

      <div class="space-y-8">
        <section>
          <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center border-b border-gray-200 dark:border-gray-800 pb-3">
            <svg class="w-5 h-5 mr-3 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path></svg>
            <span class="lang-en block">{educationData.categories?.languages?.en}</span>
            <span class="lang-es hidden">{educationData.categories?.languages?.es}</span>
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {educationData.languages && educationData.languages.map((lang) => (
              <div class="p-4 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-emerald-100 dark:border-emerald-900/30 rounded-xl shadow-sm">
                <h3 class="font-bold text-gray-900 dark:text-white mb-2 text-lg">
                  <span class="lang-en block">{lang.name?.en}</span>
                  <span class="lang-es hidden">{lang.name?.es}</span>
                </h3>
                <div class="flex items-center gap-2">
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-50 dark:bg-emerald-900/30 px-2 py-0.5 rounded-md border border-emerald-200 dark:border-emerald-800/50">
                    <span class="lang-en block">{lang.level?.en}</span>
                    <span class="lang-es hidden">{lang.level?.es}</span>
                  </span>
                  {lang.exam && (
                    <span class="text-xs font-medium text-gray-600 dark:text-gray-400 bg-white dark:bg-gray-800 px-2 py-1 rounded-md border border-gray-200 dark:border-gray-700">
                      {lang.exam}
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center border-b border-gray-200 dark:border-gray-800 pb-3">
            <svg class="w-5 h-5 mr-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            <span class="lang-en block">{educationData.categories?.misc?.en}</span>
            <span class="lang-es hidden">{educationData.categories?.misc?.es}</span>
          </h2>
          <div class="space-y-4">
            {educationData.misc && educationData.misc.map((item) => (
              <div class="p-4 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm flex justify-between items-center">
                <div>
                  <h3 class="font-bold text-gray-900 dark:text-white text-sm">
                    <span class="lang-en block">{item.title?.en}</span>
                    <span class="lang-es hidden">{item.title?.es}</span>
                  </h3>
                  <p class="text-xs text-gray-500 mt-0.5">{item.institution}</p>
                </div>
                <span class="text-xs font-mono text-gray-400 bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">
                  <span class="lang-en block">{item.date?.en}</span>
                  <span class="lang-es hidden">{item.date?.es}</span>
                </span>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  const themeBtn = document.getElementById('theme-toggle');
  const htmlDoc = document.documentElement;
  
  if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    htmlDoc.classList.add('dark');
  }

  themeBtn.addEventListener('click', () => {
    htmlDoc.classList.toggle('dark');
    localStorage.setItem('theme', htmlDoc.classList.contains('dark') ? 'dark' : 'light');
  });

  const langBtn = document.getElementById('lang-toggle');
  const enElements = document.querySelectorAll('.lang-en');
  const esElements = document.querySelectorAll('.lang-es');
  
  let currentLang = localStorage.getItem('lang') || 'en';

  function renderLanguage() {
    if (currentLang === 'en') {
      enElements.forEach(el => { el.style.display = 'block'; });
      esElements.forEach(el => { el.style.display = 'none'; });
    } else {
      esElements.forEach(el => { el.style.display = 'block'; });
      enElements.forEach(el => { el.style.display = 'none'; });
    }
  }

  renderLanguage();

  langBtn.addEventListener('click', () => {
    currentLang = currentLang === 'en' ? 'es' : 'en';
    localStorage.setItem('lang', currentLang);
    renderLanguage();
  });
</script>