---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import expData from '../data/experience.json';
---

<Layout title="Experience - Estela Mora Barba">
  <nav class="flex flex-col md:flex-row justify-between items-center p-6 gap-6 max-w-6xl mx-auto w-full">
    <a href="/" class="text-gray-900 dark:text-white font-medium flex items-center group hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
      <svg class="w-5 h-5 mr-2 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      <span class="lang-en block">Back to home</span>
      <span class="lang-es hidden">Volver al inicio</span>
    </a>

    <div class="flex flex-wrap justify-center gap-4 text-sm font-medium text-gray-700 dark:text-gray-300">
      <a href="/education" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Education</span><span class="lang-es hidden">Formación</span>
      </a>
      <a href="/experience" class="text-blue-600 dark:text-blue-400 font-bold transition-colors">
        <span class="lang-en block">Experience</span><span class="lang-es hidden">Experiencia</span>
      </a>
      <a href="/projects" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Projects</span><span class="lang-es hidden">Proyectos</span>
      </a>
      <a href="/teaching" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Teaching</span><span class="lang-es hidden">Docencia</span>
      </a>
      <a href="/publications" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Publications</span><span class="lang-es hidden">Publicaciones</span>
      </a>
      <a href="/awards" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Awards</span><span class="lang-es hidden">Premios</span>
      </a>
      <a href="/posts" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Posts</span><span class="lang-es hidden">Posts</span>
      </a>
    </div>

    <div class="flex items-center gap-4">
      <button id="lang-toggle" class="px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
        EN / ES
      </button>
      <button id="theme-toggle" class="p-2 rounded-full border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Toggle Dark Mode">
        <svg id="moon-icon" class="w-5 h-5 block dark:hidden text-gray-700" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
        <svg id="sun-icon" class="w-5 h-5 hidden dark:block text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 2.32a1 1 0 011.415 0l.708.708a1 1 0 01-1.414 1.415l-.708-.708a1 1 0 010-1.415zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zm-2.32 4.22a1 1 0 010 1.415l-.708.708a1 1 0 01-1.414-1.415l.708-.708a1 1 0 011.415 0zM10 18a1 1 0 01-1-1v-1a1 1 0 112 0v1a1 1 0 01-1 1zm-4.22-2.32a1 1 0 01-1.415 0l-.708-.708a1 1 0 011.414-1.415l.708.708a1 1 0 010 1.415zM2 10a1 1 0 011-1h1a1 1 0 110 2H3a1 1 0 01-1-1zm2.32-4.22a1 1 0 010-1.415l.708-.708a1 1 0 011.414 1.415l-.708.708a1 1 0 01-1.415 0zM10 5a5 5 0 100 10 5 5 0 000-10z" clip-rule="evenodd"></path></svg>
      </button>
    </div>
  </nav>

  <main class="max-w-4xl mx-auto px-6 py-12">
    <header class="mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-emerald-500 mb-4">
        <span class="lang-en block">{expData.header.title.en}</span>
        <span class="lang-es hidden">{expData.header.title.es}</span>
      </h1>
      <p class="text-gray-600 dark:text-gray-400 text-lg">
        <span class="lang-en block">{expData.header.subtitle.en}</span>
        <span class="lang-es hidden">{expData.header.subtitle.es}</span>
      </p>
    </header>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-10 flex items-center">
        <svg class="w-6 h-6 mr-3 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        <span class="lang-en block">{expData.categories.professional.en}</span>
        <span class="lang-es hidden">{expData.categories.professional.es}</span>
      </h2>

      <div class="space-y-16">
        {expData.professional && expData.professional.length ? expData.professional.map((job) => (
          <div class="group">
            <div class="flex items-center mb-6">
              <div class="bg-blue-600 w-1.5 h-6 rounded-full mr-3"></div>
              <h3 class="text-lg font-bold text-blue-600 dark:text-blue-400 tracking-tight">
                {job.company}
              </h3>
            </div>
            
            <div class={`ml-3.5 pl-8 relative ${job.roles.length > 1 ? 'border-l-2 border-gray-200 dark:border-gray-800' : ''}`}>
              {job.roles.map((role, index) => (
                <div class={`relative ${index !== job.roles.length - 1 ? 'mb-12' : ''}`}>
                  <span class={`absolute w-4 h-4 rounded-full -left-[43px] top-1.5 ring-4 ring-slate-50 dark:ring-gray-950 ${role.current ? 'bg-blue-500' : 'bg-gray-300 dark:bg-gray-700'}`}>
                    {role.current && <span class="absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75 animate-ping"></span>}
                  </span>
                  
                  <div class="flex flex-wrap gap-3 items-center mb-1">
                    <time class="text-sm font-mono text-gray-500 dark:text-gray-400">
                      <span class="lang-en block">{role.date.en}</span>
                      <span class="lang-es hidden">{role.date.es}</span>
                    </time>
                  </div>
                  
                  <div class="flex flex-wrap items-center gap-3 mb-2">
                    <h4 class="text-xl font-bold text-gray-900 dark:text-white">
                      <span class="lang-en block">{role.title.en}</span>
                      <span class="lang-es hidden">{role.title.es}</span>
                    </h4>
                    {role.current && 
                      <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 border border-blue-200 dark:border-blue-800 whitespace-nowrap">
                        <span class="lang-en block">{expData.badges.ongoing.en}</span>
                        <span class="lang-es hidden">{expData.badges.ongoing.es}</span>
                      </span>
                    }
                  </div>
                  
                  <p class="text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl">
                    <span class="lang-en block">{role.description.en}</span>
                    <span class="lang-es hidden">{role.description.es}</span>
                  </p>
                </div>
              ))}
            </div>
          </div>
        )) : null}
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 flex items-center">
        <svg class="w-6 h-6 mr-3 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path></svg>
        <span class="lang-en block">{expData.categories.other.en}</span>
        <span class="lang-es hidden">{expData.categories.other.es}</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {expData.other && expData.other.length ? expData.other.map((item) => (
          <div class="p-6 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm hover:border-pink-500 transition-colors">
            <div class="flex flex-wrap items-center gap-3 mb-2">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                <span class="lang-en block">{item.title.en}</span>
                <span class="lang-es hidden">{item.title.es}</span>
              </h3>
              {item.current && 
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-pink-100 text-pink-800 dark:bg-pink-900/30 dark:text-pink-300 border border-pink-200 dark:border-pink-800">
                  <span class="lang-en block">{expData.badges.ongoing.en}</span>
                  <span class="lang-es hidden">{expData.badges.ongoing.es}</span>
                </span>
              }
            </div>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-pink-600 dark:text-pink-400 font-medium">{item.organization}</span>
              <span class="text-gray-400">•</span>
              <time class="text-sm font-mono text-gray-500 dark:text-gray-400">
                <span class="lang-en block">{item.date.en}</span>
                <span class="lang-es hidden">{item.date.es}</span>
              </time>
            </div>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
              <span class="lang-en block">{item.description.en}</span>
              <span class="lang-es hidden">{item.description.es}</span>
            </p>
          </div>
        )) : null}
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 flex items-center">
        <svg class="w-6 h-6 mr-3 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
        <span class="lang-en block">{expData.categories.volunteer.en}</span>
        <span class="lang-es hidden">{expData.categories.volunteer.es}</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {expData.volunteer && expData.volunteer.length ? expData.volunteer.map((item) => (
          <div class="p-6 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm hover:border-orange-500 transition-colors">
            <span class="text-xs font-mono text-gray-500 uppercase tracking-widest block mb-2">{item.date.en}</span>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">
              <span class="lang-en block">{item.title.en}</span>
              <span class="lang-es hidden">{item.title.es}</span>
            </h3>
            <p class="text-orange-600 dark:text-orange-400 text-sm font-medium mb-3">{item.organization}</p>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
              <span class="lang-en block">{item.description.en}</span>
              <span class="lang-es hidden">{item.description.es}</span>
            </p>
          </div>
        )) : null}
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  const langBtn = document.getElementById('lang-toggle');
  const enElements = document.querySelectorAll('.lang-en');
  const esElements = document.querySelectorAll('.lang-es');
  let currentLang = localStorage.getItem('lang') || 'en';

  function renderLanguage() {
    if (currentLang === 'en') {
      enElements.forEach(el => el.style.display = 'block');
      esElements.forEach(el => el.style.display = 'none');
    } else {
      enElements.forEach(el => el.style.display = 'none');
      esElements.forEach(el => el.style.display = 'block');
    }
  }

  renderLanguage();
  langBtn.addEventListener('click', () => {
    currentLang = currentLang === 'en' ? 'es' : 'en';
    localStorage.setItem('lang', currentLang);
    renderLanguage();
  });

  const themeBtn = document.getElementById('theme-toggle');
  const htmlDoc = document.documentElement;
  if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    htmlDoc.classList.add('dark');
  }
  themeBtn.addEventListener('click', () => {
    htmlDoc.classList.toggle('dark');
    localStorage.setItem('theme', htmlDoc.classList.contains('dark') ? 'dark' : 'light');
  });
</script>