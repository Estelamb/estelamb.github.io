---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import projData from '../data/projects.json';
---

<Layout title="Projects - Estela Mora Barba">
  <nav class="flex flex-col md:flex-row justify-between items-center p-6 gap-6 max-w-6xl mx-auto w-full">
    <a href="/" class="text-gray-900 dark:text-white font-medium flex items-center group hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
      <svg class="w-5 h-5 mr-2 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      <span class="lang-en block">Back to home</span>
      <span class="lang-es hidden">Volver al inicio</span>
    </a>

    <div class="flex flex-wrap justify-center gap-4 text-sm font-medium text-gray-700 dark:text-gray-300">
      <a href="/education" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Education</span><span class="lang-es hidden">Formación</span>
      </a>
      <a href="/experience" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Experience</span><span class="lang-es hidden">Experiencia</span>
      </a>
      <a href="/projects" class="text-blue-600 dark:text-blue-400 font-bold transition-colors">
        <span class="lang-en block">Projects</span><span class="lang-es hidden">Proyectos</span>
      </a>
      <a href="/teaching" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Teaching</span><span class="lang-es hidden">Docencia</span>
      </a>
      <a href="/publications" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Publications</span><span class="lang-es hidden">Publicaciones</span>
      </a>
      <a href="/awards" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Awards</span><span class="lang-es hidden">Premios</span>
      </a>
      <a href="/posts" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Posts</span><span class="lang-es hidden">Posts</span>
      </a>
    </div>

    <div class="flex items-center gap-4">
      <button id="lang-toggle" class="px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
        EN / ES
      </button>
      <button id="theme-toggle" class="p-2 rounded-full border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Toggle Dark Mode">
        <svg id="moon-icon" class="w-5 h-5 block dark:hidden text-gray-700" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
        <svg id="sun-icon" class="w-5 h-5 hidden dark:block text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 2.32a1 1 0 011.415 0l.708.708a1 1 0 01-1.414 1.415l-.708-.708a1 1 0 010-1.415zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zm-2.32 4.22a1 1 0 010 1.415l-.708.708a1 1 0 01-1.414-1.415l.708-.708a1 1 0 011.415 0zM10 18a1 1 0 01-1-1v-1a1 1 0 112 0v1a1 1 0 01-1 1zm-4.22-2.32a1 1 0 01-1.415 0l-.708-.708a1 1 0 011.414-1.415l.708.708a1 1 0 010 1.415zM2 10a1 1 0 011-1h1a1 1 0 110 2H3a1 1 0 01-1-1zm2.32-4.22a1 1 0 010-1.415l.708-.708a1 1 0 011.414 1.415l-.708.708a1 1 0 01-1.415 0zM10 5a5 5 0 100 10 5 5 0 000-10z" clip-rule="evenodd"></path></svg>
      </button>
    </div>
  </nav>

  <main class="max-w-4xl mx-auto px-6 py-12">
    <header class="mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-emerald-500 mb-4">
        <span class="lang-en block">{projData.header.title.en}</span>
        <span class="lang-es hidden">{projData.header.title.es}</span>
      </h1>
      <p class="text-gray-600 dark:text-gray-400 text-lg">
        <span class="lang-en block">{projData.header.subtitle.en}</span>
        <span class="lang-es hidden">{projData.header.subtitle.es}</span>
      </p>
    </header>

    {/* SECCIÓN EUROPEOS */}
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
        <svg class="w-6 h-6 mr-3 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="lang-en block">{projData.categories.european.en}</span>
        <span class="lang-es hidden">{projData.categories.european.es}</span>
      </h2>
      <div class="grid gap-6">
        {projData.european && projData.european.length ? projData.european.map((proj) => (
          <div class="p-6 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm flex flex-col h-full hover:border-blue-500 transition-colors">
            
            <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-2 gap-2">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                <span class="lang-en block">{proj.title.en}</span>
                <span class="lang-es hidden">{proj.title.es}</span>
              </h3>
              <div class="flex items-center gap-2 flex-shrink-0">
                {proj.status && (
                  <span class="px-2 py-0.5 rounded-full text-[10px] uppercase font-bold tracking-wider border bg-blue-50 text-blue-600 border-blue-200 dark:bg-blue-900/30 dark:text-blue-400 dark:border-blue-800/50">
                    <span class="lang-en block">{proj.status.en}</span>
                    <span class="lang-es hidden">{proj.status.es}</span>
                  </span>
                )}
                <span class="text-sm font-mono text-gray-500">
                  <span class="lang-en block">{proj.date.en}</span>
                  <span class="lang-es hidden">{proj.date.es}</span>
                </span>
              </div>
            </div>
            
            <p class="text-blue-600 dark:text-blue-400 font-medium mb-3">
              <span class="lang-en block">{proj.role.en}</span>
              <span class="lang-es hidden">{proj.role.es}</span>
            </p>

            {/* Logo y Descripción combinados con float y clearfix */}
            <div class="mb-4 flex-grow clearfix">
              {proj.logo && (
                <img 
                  src={proj.logo} 
                  alt="Project Logo" 
                  class="float-right ml-5 mb-2 w-[80px] sm:w-[110px] h-auto object-contain rounded-xl bg-white p-2 border border-gray-100 shadow-sm dark:border-gray-700"
                />
              )}
              <p class="text-gray-600 dark:text-gray-400">
                <span class="lang-en block">{proj.description.en}</span>
                <span class="lang-es hidden">{proj.description.es}</span>
              </p>
            </div>

            <div class="mt-auto">
              <div class="flex flex-wrap gap-2 mb-4">
                {proj.tags && proj.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700">{tag}</span>
                ))}
              </div>
              {proj.link && (
                <div class="pt-4 border-t border-gray-100 dark:border-gray-800">
                  <a href={proj.link} target="_blank" class="text-blue-600 dark:text-blue-400 text-sm font-medium flex items-center group-hover:translate-x-1 transition-transform w-fit">
                    <span class="lang-en block">View Project</span>
                    <span class="lang-es hidden">Ver Proyecto</span>
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  </a>
                </div>
              )}
            </div>

          </div>
        )) : <p class="text-gray-500 dark:text-gray-400 italic bg-gray-50 dark:bg-gray-800/50 p-4 rounded-xl border border-dashed border-gray-200 dark:border-gray-700">
              <span class="lang-en block">{projData.emptyState.en}</span>
              <span class="lang-es hidden">{projData.emptyState.es}</span>
             </p>}
      </div>
    </section>

    {/* SECCIÓN NACIONALES */}
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
        <svg class="w-6 h-6 mr-3 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"></path></svg>
        <span class="lang-en block">{projData.categories.national.en}</span>
        <span class="lang-es hidden">{projData.categories.national.es}</span>
      </h2>
      <div class="grid gap-6">
        {projData.national && projData.national.length ? projData.national.map((proj) => (
          <div class="p-6 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm flex flex-col h-full hover:border-red-500 transition-colors">
            
            <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-2 gap-2">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                <span class="lang-en block">{proj.title.en}</span>
                <span class="lang-es hidden">{proj.title.es}</span>
              </h3>
              <div class="flex items-center gap-2 flex-shrink-0">
                {proj.status && (
                  <span class="px-2 py-0.5 rounded-full text-[10px] uppercase font-bold tracking-wider border bg-red-50 text-red-600 border-red-200 dark:bg-red-900/30 dark:text-red-400 dark:border-red-800/50">
                    <span class="lang-en block">{proj.status.en}</span>
                    <span class="lang-es hidden">{proj.status.es}</span>
                  </span>
                )}
                <span class="text-sm font-mono text-gray-500">
                  <span class="lang-en block">{proj.date.en}</span>
                  <span class="lang-es hidden">{proj.date.es}</span>
                </span>
              </div>
            </div>
            
            <p class="text-red-600 dark:text-red-400 font-medium mb-3">
              <span class="lang-en block">{proj.role.en}</span>
              <span class="lang-es hidden">{proj.role.es}</span>
            </p>

            <div class="mb-4 flex-grow clearfix">
              {proj.logo && (
                <img 
                  src={proj.logo} 
                  alt="Project Logo" 
                  class="float-right ml-5 mb-2 w-[80px] sm:w-[110px] h-auto object-contain rounded-xl bg-white p-2 border border-gray-100 shadow-sm dark:border-gray-700"
                />
              )}
              <p class="text-gray-600 dark:text-gray-400">
                <span class="lang-en block">{proj.description.en}</span>
                <span class="lang-es hidden">{proj.description.es}</span>
              </p>
            </div>

            <div class="mt-auto">
              <div class="flex flex-wrap gap-2 mb-4">
                {proj.tags && proj.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700">{tag}</span>
                ))}
              </div>
              {proj.link && (
                <div class="pt-4 border-t border-gray-100 dark:border-gray-800">
                  <a href={proj.link} target="_blank" class="text-red-600 dark:text-red-400 text-sm font-medium flex items-center group-hover:translate-x-1 transition-transform w-fit">
                    <span class="lang-en block">View Project</span>
                    <span class="lang-es hidden">Ver Proyecto</span>
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  </a>
                </div>
              )}
            </div>

          </div>
        )) : <p class="text-gray-500 dark:text-gray-400 italic bg-gray-50 dark:bg-gray-800/50 p-4 rounded-xl border border-dashed border-gray-200 dark:border-gray-700">
              <span class="lang-en block">{projData.emptyState.en}</span>
              <span class="lang-es hidden">{projData.emptyState.es}</span>
             </p>}
      </div>
    </section>

    {/* SECCIÓN GRyS */}
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
        <svg class="w-6 h-6 mr-3 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
        <span class="lang-en block">{projData.categories.grys.en}</span>
        <span class="lang-es hidden">{projData.categories.grys.es}</span>
      </h2>
      <div class="grid gap-6">
        {projData.grys && projData.grys.length ? projData.grys.map((proj) => (
          <div class="p-6 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm flex flex-col h-full hover:border-emerald-500 transition-colors">
            
            <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-2 gap-2">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                <span class="lang-en block">{proj.title.en}</span>
                <span class="lang-es hidden">{proj.title.es}</span>
              </h3>
              <div class="flex items-center gap-2 flex-shrink-0">
                {proj.status && (
                  <span class="px-2 py-0.5 rounded-full text-[10px] uppercase font-bold tracking-wider border bg-emerald-50 text-emerald-600 border-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-400 dark:border-emerald-800/50">
                    <span class="lang-en block">{proj.status.en}</span>
                    <span class="lang-es hidden">{proj.status.es}</span>
                  </span>
                )}
                <span class="text-sm font-mono text-gray-500">
                  <span class="lang-en block">{proj.date.en}</span>
                  <span class="lang-es hidden">{proj.date.es}</span>
                </span>
              </div>
            </div>
            
            <p class="text-emerald-600 dark:text-emerald-400 font-medium mb-3">
              <span class="lang-en block">{proj.role.en}</span>
              <span class="lang-es hidden">{proj.role.es}</span>
            </p>

            <div class="mb-4 flex-grow clearfix">
              {proj.logo && (
                <img 
                  src={proj.logo} 
                  alt="Project Logo" 
                  class="float-right ml-5 mb-2 w-[80px] sm:w-[210px] h-auto object-contain rounded-xl bg-white p-2 border border-gray-100 shadow-sm dark:border-gray-700"
                />
              )}
              <p class="text-gray-600 dark:text-gray-400">
                <span class="lang-en block">{proj.description.en}</span>
                <span class="lang-es hidden">{proj.description.es}</span>
              </p>
            </div>

            <div class="mt-auto">
              <div class="flex flex-wrap gap-2 mb-4">
                {proj.tags && proj.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700">{tag}</span>
                ))}
              </div>
              {proj.link && (
                <div class="pt-4 border-t border-gray-100 dark:border-gray-800">
                  <a href={proj.link} target="_blank" class="text-emerald-600 dark:text-emerald-400 text-sm font-medium flex items-center group-hover:translate-x-1 transition-transform w-fit">
                    <span class="lang-en block">View Project</span>
                    <span class="lang-es hidden">Ver Proyecto</span>
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  </a>
                </div>
              )}
            </div>

          </div>
        )) : <p class="text-gray-500 dark:text-gray-400 italic bg-gray-50 dark:bg-gray-800/50 p-4 rounded-xl border border-dashed border-gray-200 dark:border-gray-700">
              <span class="lang-en block">{projData.emptyState.en}</span>
              <span class="lang-es hidden">{projData.emptyState.es}</span>
             </p>}
      </div>
    </section>

    {/* SECCIÓN OTROS */}
    <section>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
        <svg class="w-6 h-6 mr-3 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"></path></svg>
        <span class="lang-en block">{projData.categories.other.en}</span>
        <span class="lang-es hidden">{projData.categories.other.es}</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {projData.other && projData.other.length ? projData.other.map((proj) => (
           <div class="p-6 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm flex flex-col h-full hover:border-purple-500 transition-colors">
            
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-lg font-bold text-gray-900 dark:text-white">
                <span class="lang-en block">{proj.title.en}</span>
                <span class="lang-es hidden">{proj.title.es}</span>
              </h3>
              {proj.status && (
                <span class="px-2 py-0.5 rounded-full text-[10px] uppercase font-bold tracking-wider border bg-purple-50 text-purple-600 border-purple-200 dark:bg-purple-900/30 dark:text-purple-400 dark:border-purple-800/50">
                  <span class="lang-en block">{proj.status.en}</span>
                  <span class="lang-es hidden">{proj.status.es}</span>
                </span>
              )}
            </div>
            
            <p class="text-purple-600 dark:text-purple-400 text-sm font-medium mb-3">
              <span class="lang-en block">{proj.role.en} • {proj.date.en}</span>
              <span class="lang-es hidden">{proj.role.es} • {proj.date.es}</span>
            </p>

            <div class="mb-4 flex-grow clearfix">
              {proj.logo && (
                <img 
                  src={proj.logo} 
                  alt="Project Logo" 
                  class="float-right ml-4 mb-2 w-[70px] h-auto object-contain rounded-lg bg-white p-1.5 border border-gray-100 shadow-sm dark:border-gray-700"
                />
              )}
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                <span class="lang-en block">{proj.description.en}</span>
                <span class="lang-es hidden">{proj.description.es}</span>
              </p>
            </div>

            <div class="mt-auto">
              <div class="flex flex-wrap gap-2 mb-4">
                {proj.tags && proj.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700">{tag}</span>
                ))}
              </div>
              {proj.link && (
                <div class="pt-4 border-t border-gray-100 dark:border-gray-800">
                  <a href={proj.link} target="_blank" class="text-purple-600 dark:text-purple-400 text-sm font-medium flex items-center group-hover:translate-x-1 transition-transform w-fit">
                    <span class="lang-en block">View Repository</span>
                    <span class="lang-es hidden">Ver Repositorio</span>
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  </a>
                </div>
              )}
            </div>

          </div>
        )) : <p class="text-gray-500 dark:text-gray-400 italic bg-gray-50 dark:bg-gray-800/50 p-4 rounded-xl border border-dashed border-gray-200 dark:border-gray-700">
              <span class="lang-en block">{projData.emptyState.en}</span>
              <span class="lang-es hidden">{projData.emptyState.es}</span>
             </p>}
      </div>
    </section>

  </main>
</Layout>

<script is:inline>
  const themeBtn = document.getElementById('theme-toggle');
  const htmlDoc = document.documentElement;
  
  if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    htmlDoc.classList.add('dark');
  }

  themeBtn.addEventListener('click', () => {
    htmlDoc.classList.toggle('dark');
    localStorage.setItem('theme', htmlDoc.classList.contains('dark') ? 'dark' : 'light');
  });

  const langBtn = document.getElementById('lang-toggle');
  const enElements = document.querySelectorAll('.lang-en');
  const esElements = document.querySelectorAll('.lang-es');
  
  let currentLang = localStorage.getItem('lang') || 'en';

  function renderLanguage() {
    if (currentLang === 'en') {
      enElements.forEach(el => { el.classList.remove('hidden'); el.classList.add('block'); });
      esElements.forEach(el => { el.classList.add('hidden'); el.classList.remove('block'); });
    } else {
      esElements.forEach(el => { el.classList.remove('hidden'); el.classList.add('block'); });
      enElements.forEach(el => { el.classList.add('hidden'); el.classList.remove('block'); });
    }
  }

  renderLanguage();

  langBtn.addEventListener('click', () => {
    currentLang = currentLang === 'en' ? 'es' : 'en';
    localStorage.setItem('lang', currentLang);
    renderLanguage();
  });
</script>