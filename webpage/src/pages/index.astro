---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import profileData from '../data/profile.json';

const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
// Obtenemos las 5 noticias más recientes
const recentPosts = allPosts
  .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf())
  .slice(0, 5);

// Triplicamos el array para generar el efecto de rueda infinita fluida
const carouselPosts = [...recentPosts, ...recentPosts, ...recentPosts, ...recentPosts];
---

<Layout title={profileData.name}>
  {/* NAVEGACIÓN - Alineada con max-w-6xl */}
  <nav class="flex flex-col md:flex-row justify-between items-center p-6 gap-6 max-w-6xl mx-auto w-full">
    <div class="flex flex-wrap justify-center gap-4 text-sm font-medium text-gray-700 dark:text-gray-300">
      <a href="/education" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Education</span><span class="lang-es hidden">Formación</span>
      </a>
      <a href="/experience" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Experience</span><span class="lang-es hidden">Experiencia</span>
      </a>
      <a href="/projects" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Projects</span><span class="lang-es hidden">Proyectos</span>
      </a>
      <a href="/teaching" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Teaching</span><span class="lang-es hidden">Docencia</span>
      </a>
      <a href="/publications" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Publications</span><span class="lang-es hidden">Publicaciones</span>
      </a>
      <a href="/awards" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Awards</span><span class="lang-es hidden">Premios</span>
      </a>
      <a href="/posts" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Posts</span><span class="lang-es hidden">Posts</span>
      </a>
    </div>

    <div class="flex items-center gap-4">
      <button id="lang-toggle" class="px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
        EN / ES
      </button>
      <button id="theme-toggle" class="p-2 rounded-full border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Toggle Dark Mode">
        <svg id="moon-icon" class="w-5 h-5 block dark:hidden text-gray-700" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
        <svg id="sun-icon" class="w-5 h-5 hidden dark:block text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 2.32a1 1 0 011.415 0l.708.708a1 1 0 01-1.414 1.415l-.708-.708a1 1 0 010-1.415zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zm-2.32 4.22a1 1 0 010 1.415l-.708.708a1 1 0 01-1.414-1.415l.708-.708a1 1 0 011.415 0zM10 18a1 1 0 01-1-1v-1a1 1 0 112 0v1a1 1 0 01-1 1zm-4.22-2.32a1 1 0 01-1.415 0l-.708-.708a1 1 0 011.414-1.415l.708.708a1 1 0 010 1.415zM2 10a1 1 0 011-1h1a1 1 0 110 2H3a1 1 0 01-1-1zm2.32-4.22a1 1 0 010-1.415l.708-.708a1 1 0 011.414 1.415l-.708.708a1 1 0 01-1.415 0zM10 5a5 5 0 100 10 5 5 0 000-10z" clip-rule="evenodd"></path></svg>
      </button>
    </div>
  </nav>

  {/* PERFIL - Ahora usa max-w-6xl y justify-between para alinearse con los extremos */}
  <main class="max-w-6xl mx-auto px-6 pt-16 pb-8 flex flex-col-reverse md:flex-row items-center justify-between gap-12">
    <div class="flex-1 text-center md:text-left max-w-3xl">
      
      <div class="lang-en block">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white tracking-tight mb-4">
          Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-emerald-500">{profileData.name}</span>
        </h1>
        <h2 class="text-xl font-medium mb-6">
          <span class="block text-gray-800 dark:text-gray-200">{profileData.en.degree}</span>
          <span class="block mt-1 text-lg text-gray-500 dark:text-gray-400">{profileData.en.jobs}</span>
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed mx-auto md:mx-0" set:html={profileData.en.bio}></p>
      </div>

      <div class="lang-es hidden">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white tracking-tight mb-4">
          Hola, soy <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-emerald-500">{profileData.name}</span>
        </h1>
        <h2 class="text-xl font-medium mb-6">
          <span class="block text-gray-800 dark:text-gray-200">{profileData.es.degree}</span>
          <span class="block mt-1 text-lg text-gray-500 dark:text-gray-400">{profileData.es.jobs}</span>
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed mx-auto md:mx-0" set:html={profileData.es.bio}></p>
      </div>

      {/* Solo 2 Botones CV. El JS cambiará el atributo href dependiendo del idioma */}
      <div class="flex flex-wrap justify-center md:justify-start gap-4 mb-8">
        <a id="btn-cv-normal" 
           href={profileData.cvNormal.en} 
           data-en={profileData.cvNormal.en} 
           data-es={profileData.cvNormal.es} 
           target="_blank" download 
           class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          <span class="lang-en block">Download CV</span>
          <span class="lang-es hidden">Descargar CV</span>
        </a>
        
        <a id="btn-cv-europass" 
           href={profileData.cvEuropass.en} 
           data-en={profileData.cvEuropass.en} 
           data-es={profileData.cvEuropass.es} 
           target="_blank" download 
           class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium text-gray-700 bg-white dark:text-gray-200 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg shadow-sm transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span class="lang-en block">Europass CV</span>
          <span class="lang-es hidden">CV Europass</span>
        </a>
      </div>

      <div class="flex flex-wrap justify-center md:justify-start gap-5 items-center">
        <a href={profileData.linkedinLink} target="_blank" class="hover:opacity-80 transition-all scale-110" title="LinkedIn">
          <img src="/icons/linkedin.png" alt="LinkedIn" class="w-6 h-6 object-contain" />
        </a>
        <a href={profileData.scholarLink} target="_blank" class="hover:opacity-80 transition-all scale-110" title="Google Scholar">
          <img src="/icons/scholar.png" alt="Google Scholar" class="w-6 h-6 object-contain" />
        </a>
        <a href={profileData.orcidLink} target="_blank" class="hover:opacity-80 transition-all scale-110" title="ORCID">
          <img src="/icons/orcid.png" alt="ORCID" class="w-6 h-6 object-contain" />
        </a>
        <a href={profileData.researchGateLink} target="_blank" class="hover:opacity-80 transition-all scale-110" title="ResearchGate">
          <img src="/icons/researchgate.png" alt="ResearchGate" class="w-6 h-6 object-contain" />
        </a>
        <a href={profileData.githubLink} target="_blank" class="hover:opacity-80 transition-all scale-110" title="GitHub">
          <img src="/icons/github.png" alt="GitHub" class="w-6 h-6 object-contain dark:invert" />
        </a>
      </div>

      <div class="mt-8 flex flex-col gap-3 items-center md:items-start">
        <a href={`mailto:${profileData.institutionalEmail}`} class="text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          {profileData.institutionalEmail}
        </a>
        <a href={`mailto:${profileData.personalEmail}`} class="text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          {profileData.personalEmail}
        </a>
        {profileData.phone && (
          <a href={`tel:${profileData.phone.replace(/\s+/g, '')}`} class="text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            {profileData.phone}
          </a>
        )}
      </div>
    </div>

    <div class="w-56 h-56 md:w-72 md:h-72 flex-shrink-0">
      <div class="w-full h-full rounded-full bg-gradient-to-tr from-blue-200 to-emerald-100 dark:from-gray-700 dark:to-gray-800 p-2 shadow-2xl">
        <img 
          src={profileData.photo} 
          alt={profileData.name} 
          class="w-full h-full rounded-full object-cover border-4 border-white dark:border-gray-900"
        />
      </div>
    </div>
  </main>

  {/* NOTICIAS - Alineadas con max-w-6xl */}
  <section class="max-w-6xl mx-auto pb-20 mt-12 overflow-hidden">
    <div class="px-6 flex justify-between items-end mb-6">
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
        <span class="lang-es hidden">Últimas Noticias</span>
        <span class="lang-en block">Latest News</span>
      </h3>
      <a href="/posts" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">
        <span class="lang-es hidden">Ver todos</span>
        <span class="lang-en block">View all</span>
      </a>
    </div>

    {/* Carrusel: Rueda Centrada e Infinita */}
    <div class="relative group w-full" id="carousel-wrapper">
      
      <button id="prev-news" class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 w-12 h-12 bg-white dark:bg-gray-800 rounded-full shadow-lg hover:bg-gray-50 dark:hover:bg-gray-700 flex items-center justify-center z-20 transition-all opacity-0 group-hover:opacity-100 border border-gray-200 dark:border-gray-700 hover:scale-110 cursor-pointer">
        <svg class="w-6 h-6 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      </button>

      {/* px-[calc(...)] asegura que el primer elemento se sitúe siempre en el centro exacto de la pantalla */}
      <div id="news-scroll" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scrollbar-hide py-4 px-[calc(50%-160px)] md:px-[calc(50%-190px)] scroll-smooth">
        {carouselPosts.map((post: any) => (
          <a href={post.url} class="news-card snap-center w-[320px] md:w-[380px] h-[220px] flex flex-col flex-shrink-0 p-6 bg-white/70 dark:bg-gray-900/70 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm hover:-translate-y-2 hover:border-blue-500 transition-all cursor-pointer">
            <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2 line-clamp-2" set:html={post.frontmatter.title}></h4>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-4 line-clamp-3 flex-grow" set:html={post.frontmatter.description}></p>
            <span class="text-xs font-mono text-blue-600 dark:text-blue-400 mt-auto">{post.frontmatter.date}</span>
          </a>
        ))}
      </div>

      <button id="next-news" class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 w-12 h-12 bg-white dark:bg-gray-800 rounded-full shadow-lg hover:bg-gray-50 dark:hover:bg-gray-700 flex items-center justify-center z-20 transition-all opacity-0 group-hover:opacity-100 border border-gray-200 dark:border-gray-700 hover:scale-110 cursor-pointer">
        <svg class="w-6 h-6 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </section>
</Layout>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script is:inline>
  const themeBtn = document.getElementById('theme-toggle');
  const htmlDoc = document.documentElement;
  
  if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    htmlDoc.classList.add('dark');
  }

  themeBtn.addEventListener('click', () => {
    htmlDoc.classList.toggle('dark');
    localStorage.setItem('theme', htmlDoc.classList.contains('dark') ? 'dark' : 'light');
  });

  const langBtn = document.getElementById('lang-toggle');
  const enElements = document.querySelectorAll('.lang-en');
  const esElements = document.querySelectorAll('.lang-es');
  
  const btnCvNormal = document.getElementById('btn-cv-normal');
  const btnCvEuropass = document.getElementById('btn-cv-europass');

  let currentLang = localStorage.getItem('lang') || 'en';

  function renderLanguage() {
    if (currentLang === 'en') {
      enElements.forEach(el => el.classList.remove('hidden'));
      esElements.forEach(el => el.classList.add('hidden'));
      
      // Actualizar Links de los CVs
      if(btnCvNormal) btnCvNormal.href = btnCvNormal.getAttribute('data-en');
      if(btnCvEuropass) btnCvEuropass.href = btnCvEuropass.getAttribute('data-en');
    } else {
      esElements.forEach(el => el.classList.remove('hidden'));
      enElements.forEach(el => el.classList.add('hidden'));

      // Actualizar Links de los CVs
      if(btnCvNormal) btnCvNormal.href = btnCvNormal.getAttribute('data-es');
      if(btnCvEuropass) btnCvEuropass.href = btnCvEuropass.getAttribute('data-es');
    }
  }

  renderLanguage();

  langBtn.addEventListener('click', () => {
    currentLang = currentLang === 'en' ? 'es' : 'en';
    localStorage.setItem('lang', currentLang);
    renderLanguage();
  });

  // --- Lógica del Carrusel (Rueda Infinita CSS + JS) ---
  document.addEventListener('DOMContentLoaded', () => {
    const scrollContainer = document.getElementById('news-scroll');
    const prevBtn = document.getElementById('prev-news');
    const nextBtn = document.getElementById('next-news');
    const wrapper = document.getElementById('carousel-wrapper');

    if (!scrollContainer) return;

    // Posicionar el scroll inicialmente en el "centro" del array duplicado
    setTimeout(() => {
      const cards = scrollContainer.querySelectorAll('.news-card');
      if(cards.length > 5) {
        // Hacemos scroll invisible hasta el bloque central
        scrollContainer.scrollTo({ left: scrollContainer.scrollWidth / 3, behavior: 'instant' });
      }
    }, 100);

    const getCardWidth = () => scrollContainer.querySelector('.news-card').offsetWidth + 24; // 24 = gap-6

    const scrollNext = () => {
      scrollContainer.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
    };

    const scrollPrev = () => {
      scrollContainer.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
    };

    // Si llegamos a los extremos, saltamos invisiblemente al centro para crear la rueda
    scrollContainer.addEventListener('scroll', () => {
      const maxScroll = scrollContainer.scrollWidth - scrollContainer.clientWidth;
      
      if (scrollContainer.scrollLeft <= 5) {
        // Hit left wall -> jump to middle
        scrollContainer.scrollTo({ left: scrollContainer.scrollWidth / 2, behavior: 'instant' });
      } else if (scrollContainer.scrollLeft >= maxScroll - 5) {
        // Hit right wall -> jump to middle
        scrollContainer.scrollTo({ left: scrollContainer.scrollWidth / 2 - scrollContainer.clientWidth, behavior: 'instant' });
      }
    });

    if (nextBtn) nextBtn.addEventListener('click', scrollNext);
    if (prevBtn) prevBtn.addEventListener('click', scrollPrev);

    // Auto rotación cada 10 segundos
    let autoRotate = setInterval(scrollNext, 10000);

    if (wrapper) {
      wrapper.addEventListener('mouseenter', () => clearInterval(autoRotate));
      wrapper.addEventListener('mouseleave', () => {
        autoRotate = setInterval(scrollNext, 10000);
      });
    }
  });
</script>