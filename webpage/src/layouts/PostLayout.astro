---
import '../styles/global.css';
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <nav class="flex flex-col md:flex-row justify-between items-center p-6 gap-6 max-w-6xl mx-auto w-full">
    <a href="/posts" class="text-gray-900 dark:text-white font-medium flex items-center group hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
      <svg class="w-5 h-5 mr-2 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      <span class="lang-en block">Back to posts</span>
      <span class="lang-es hidden">Volver a posts</span>
    </a>

    <div class="flex flex-wrap justify-center gap-4 text-sm font-medium text-gray-700 dark:text-gray-300">
      <a href="/education" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Education</span><span class="lang-es hidden">Formación</span>
      </a>
      <a href="/experience" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Experience</span><span class="lang-es hidden">Experiencia</span>
      </a>
      <a href="/projects" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Projects</span><span class="lang-es hidden">Proyectos</span>
      </a>
      <a href="/teaching" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Teaching</span><span class="lang-es hidden">Docencia</span>
      </a>
      <a href="/publications" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Publications</span><span class="lang-es hidden">Publicaciones</span>
      </a>
      <a href="/awards" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <span class="lang-en block">Awards</span><span class="lang-es hidden">Premios</span>
      </a>
      <a href="/posts" class="text-blue-600 dark:text-blue-400 font-bold">
        <span class="lang-en block">Posts</span><span class="lang-es hidden">Posts</span>
      </a>
    </div>

    <div class="flex items-center gap-4">
      <button id="lang-toggle" class="px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">EN / ES</button>
      <button id="theme-toggle" class="p-2 rounded-full border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
        <svg id="moon-icon" class="w-5 h-5 block dark:hidden text-gray-700" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
        <svg id="sun-icon" class="w-5 h-5 hidden dark:block text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 2.32a1 1 0 011.415 0l.708.708a1 1 0 01-1.414 1.415l-.708-.708a1 1 0 010-1.415zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zm-2.32 4.22a1 1 0 010 1.415l-.708.708a1 1 0 01-1.414-1.415l.708-.708a1 1 0 011.415 0zM10 18a1 1 0 01-1-1v-1a1 1 0 112 0v1a1 1 0 01-1 1zm-4.22-2.32a1 1 0 01-1.415 0l-.708-.708a1 1 0 011.414-1.415l.708.708a1 1 0 010 1.415zM2 10a1 1 0 011-1h1a1 1 0 110 2H3a1 1 0 01-1-1zm2.32-4.22a1 1 0 010-1.415l.708-.708a1 1 0 011.414 1.415l-.708.708a1 1 0 01-1.415 0zM10 5a5 5 0 100 10 5 5 0 000-10z" clip-rule="evenodd"></path></svg>
      </button>
    </div>
  </nav>

  <main class="max-w-4xl mx-auto px-6 py-12">
    <div class="mb-8 text-center">
      <span class="inline-block px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 font-mono text-sm font-bold mb-4">
        {frontmatter.date}
      </span>
    </div>

    <article class="bg-white/40 dark:bg-gray-900/40 backdrop-blur-xl border border-gray-200 dark:border-gray-800 rounded-3xl p-8 md:p-12 shadow-sm markdown-content">
      <slot />
    </article>
  </main>

<style is:global>
    @reference "../styles/global.css";

    /* Configuramos la base del texto a un tamaño normal (text-base) */
    .markdown-content {
      @apply text-gray-700 dark:text-gray-300 text-base leading-relaxed;
    }

    /* Título principal (H1) un poco más contenido */
    .markdown-content h1 {
      @apply text-3xl md:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-emerald-500 mb-8 mt-2 leading-tight;
    }

    /* Subtítulos (H2) */
    .markdown-content h2 {
      @apply text-xl md:text-2xl font-bold text-gray-900 dark:text-white mb-5 mt-10 border-b border-gray-200 dark:border-gray-800 pb-2 flex items-center;
    }

    /* Títulos menores (H3) */
    .markdown-content h3 {
      @apply text-lg font-bold text-gray-800 dark:text-gray-100 mb-3 mt-6;
    }

    /* Párrafos normales */
    .markdown-content p {
      @apply mb-5;
    }

    /* Negritas fuertes que no se pierdan en modo oscuro */
    .markdown-content strong {
      @apply font-extrabold text-gray-900 dark:text-white;
    }

    /* Listas con puntos y separación */
    .markdown-content ul {
      @apply list-disc list-outside ml-6 mb-6 space-y-2 text-gray-700 dark:text-gray-300;
    }
    
    .markdown-content li {
      @apply pl-1;
    }

    /* Imágenes adaptables por defecto */
    .markdown-content img {
      @apply rounded-2xl shadow-lg border border-gray-200 dark:border-gray-800 mb-4 mt-6 w-full object-cover max-h-[500px];
    }

    /* Cursivas usadas para el pie de foto */
    .markdown-content em {
      @apply block text-center text-sm text-gray-500 dark:text-gray-400 mb-8 not-italic;
    }

    /* Enlaces dentro del texto (excluyendo los que tienen clase 'btn-enlace') */
    .markdown-content a:not(.btn-enlace) {
      @apply text-blue-600 dark:text-blue-400 font-medium hover:underline;
    }
  </style>

  <script is:inline>
    const themeBtn = document.getElementById('theme-toggle');
    const htmlDoc = document.documentElement;
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      htmlDoc.classList.add('dark');
    }
    themeBtn.addEventListener('click', () => {
      htmlDoc.classList.toggle('dark');
      localStorage.setItem('theme', htmlDoc.classList.contains('dark') ? 'dark' : 'light');
    });

    const langBtn = document.getElementById('lang-toggle');
    const enElements = document.querySelectorAll('.lang-en');
    const esElements = document.querySelectorAll('.lang-es');
    let currentLang = localStorage.getItem('lang') || 'en';
    function renderLanguage() {
      if (currentLang === 'en') {
        enElements.forEach(el => el.style.display = 'block');
        esElements.forEach(el => el.style.display = 'none');
      } else {
        enElements.forEach(el => el.style.display = 'none');
        esElements.forEach(el => el.style.display = 'block');
      }
    }
    renderLanguage();
    langBtn.addEventListener('click', () => {
      currentLang = currentLang === 'en' ? 'es' : 'en';
      localStorage.setItem('lang', currentLang);
      renderLanguage();
    });
  </script>
</Layout>